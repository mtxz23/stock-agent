# 本机独立Qdrant，管理界面为此地址下的/dashboard
STOCK_QDRANT_URL=http://127.0.0.1:6333

# 模型、向量生成和原文读取默认直连；true 时读取 HTTP_PROXY/HTTPS_PROXY/ALL_PROXY
STOCK_USE_ENV_PROXY=false

# 自选默认自动发现远航版安装目录；多个安装或账号时可取消下面注释并指定
# STOCK_THS_INSTALL_DIR=D:/同花顺远航版
# STOCK_THS_ACCOUNT=bin/users 下的账号目录名
STOCK_WATCHLIST_POLL_INTERVAL=10

# 股票数据独立查询总超时（与模型请求超时分开）
STOCK_MARKET_DATA_TIMEOUT=30
